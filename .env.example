# Configuração do Banco de Dados PostgreSQL (Local, Docker ou Nuvem)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/beautyflow

NODE_ENV=development
PORT=3000

# Origens permitidas para CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,https://seu-site.vercel.app

# Chave de API do Google Gemini (necessária para as rotas /api/marketing)
GEMINI_API_KEY=sua_chave_gemini_aqui

