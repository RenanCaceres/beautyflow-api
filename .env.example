# Configuração do Banco de Dados PostgreSQL (Local, Docker ou Nuvem)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/beautyflow

NODE_ENV=development
PORT=3000

# Segredo JWT para autenticação SaaS (gere uma string longa e aleatória em produção)
JWT_SECRET=troque-por-um-segredo-jwt-bem-longo-e-aleatorio
JWT_EXPIRES_IN=30d

# Conta inicial da Vanessa (criada automaticamente se a tabela usuarios estiver vazia)
VANESSA_USUARIO=vanessa
VANESSA_NOME=Vanessa
VANESSA_SALAO=Studio Vanessa
VANESSA_EMAIL=
VANESSA_SENHA=troque-esta-senha-agora

# Origens permitidas para CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,https://seu-site.vercel.app

# Chave de API do Google Gemini (necessária para as rotas /api/marketing e retorno inteligente)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Cidade do salão para consulta de clima em tempo real (módulo de Retorno)
CIDADE_NOME=São Paulo - SP
CIDADE_LAT=-23.5505
CIDADE_LON=-46.6333

# Integração WAHA (https://waha.devlike.pro) e Proteção Anti-Ban (Range Limit)
WAHA_URL=http://localhost:3001
WAHA_API_KEY=troque-por-uma-chave-forte
WAHA_SESSION=default
WA_DELAY_MIN_S=25
WA_DELAY_MAX_S=60
WA_LIMITE_24H=100
WA_RETORNO_MAX_ATRASO_DIAS=7
WA_RETORNO_CRON=0 10 * * *
